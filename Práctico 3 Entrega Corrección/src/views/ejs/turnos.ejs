<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Turnos</title>
  <style>
    body{
      background-color: lightblue;
      font-family: Arial, Helvetica, sans-serif;
    }
  </style>
</head>
<body>
  <h1>Turnos</h1>
  <a href="/turnos/nuevo">Nuevo turno</a>
  <ul>
    <% turnos.forEach(t => { %>
      <li>
        Paciente: <%= t.idPaciente %> - <%= t.fecha %> <%= t.hora %> - <%= t.motivo %>
        <form action="/turnos/cancelar/<%= t.id %>" method="POST" style="display:inline;">
          <button type="submit">Cancelar</button>
        </form>
      </li>
    <% }) %>
  </ul>
</body>
</html>
